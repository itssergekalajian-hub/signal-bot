# ── Telegram: reading the channel (USER account, not a bot) ─────────────
# From https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
TG_CHANNEL=@the_signals_channel        # @username, invite link, or numeric id

# ── Telegram: the confirm bot that DMs you Buy/Skip buttons ─────────────
# Create a bot with @BotFather, paste its token. Then DM your bot once so it
# can message you. Get YOUR numeric id from @userinfobot.
TG_BOT_TOKEN=123456:ABC-your-bot-token
TG_OWNER_ID=987654321

# ── Solana wallet (DEDICATED HOT WALLET — see README) ──────────────────
# Base58 secret key of a THROWAWAY wallet holding only what you can lose.
# NEVER put your main wallet's key here.
SOLANA_PRIVATE_KEY=base58_secret_key_here
# RPC endpoint — read your token balances for the take-profit sell. Public
# endpoint works to start; a Helius/QuickNode URL is more reliable.
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ── Jupiter Ultra API ──────────────────────────────────────────────────
# Free tier uses lite-api. With a key from portal.jup.ag use api.jup.ag.
JUPITER_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=                        # optional; leave blank for free tier

# ── Execution ──────────────────────────────────────────────────────────
DRY_RUN=true                            # true = never actually swaps
AUTO_TRADE=false                        # true = buy the instant a call passes
                                        #        the safety gate (no tap).
                                        # false = DM you a Buy/Skip button.
BUY_AMOUNT_SOL=0.05                     # fixed size per approved buy
SLIPPAGE_BPS=300                        # 3% — memecoins move fast

# ── Take-profit: "sell 50% at 2x / 100% ROI" ───────────────────────────
TAKE_PROFIT_MULT=2.0                    # 2.0 = 2x = +100% ROI
TAKE_PROFIT_SELL_PCT=50                 # % of the position to sell at that mult
SELL_SLIPPAGE_BPS=500                   # 5% — exits need more room than entries
POLL_INTERVAL_SEC=30                    # how often to re-price open positions

# ── Safety gate (hard filters BEFORE you even see a Buy button) ─────────
MAX_RUGCHECK_SCORE=2000                 # RugCheck risk score; lower = safer
MIN_LIQUIDITY_USD=5000                  # skip illiquid pools you can't exit
MIN_PAIR_AGE_MIN=0                      # e.g. 5 to avoid 0-second snipes
REQUIRE_MINT_AUTHORITY_REVOKED=true     # creator can't print more supply
REQUIRE_FREEZE_AUTHORITY_REVOKED=true   # creator can't freeze your tokens
MAX_TOP_HOLDER_PCT=25                   # skip if one wallet holds > this %

# ── Telegram: reading the channel (USER account, not a bot) ─────────────
# From https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here
TG_CHANNEL=@the_signals_channel        # one channel, OR several comma-separated:
                                       # @MarkDegens,-1002312141364
                                       # (@username for public, numeric id for private)

# ── Telegram: the bot that DMs you buttons + status ─────────────────────
# Create a bot with @BotFather, paste its token. Then DM your bot once so it
# can message you. Get YOUR numeric id from @userinfobot.
TG_BOT_TOKEN=123456:ABC-your-bot-token
TG_OWNER_ID=987654321

# ── Wallets (DEDICATED THROWAWAY WALLETS — see README) ─────────────────
# ONE EVM key covers every EVM chain (BSC, Ethereum, Arbitrum, Base, …).
# Fund it with native gas on each chain you want to trade (BNB on BSC, etc.).
EVM_PRIVATE_KEY=0xyour_throwaway_evm_private_key
# Solana key (only needed if you'll trade Solana calls).
SOLANA_PRIVATE_KEY=base58_secret_key_here

# ── RPC endpoints (public defaults work; paid ones are more reliable) ───
SOLANA_RPC=https://api.mainnet-beta.solana.com
# Override any EVM chain's RPC with <CHAIN>_RPC (optional):
# ETH_RPC=...   BSC_RPC=...   ARBITRUM_RPC=...   BASE_RPC=...
# POLYGON_RPC=...   OPTIMISM_RPC=...   AVALANCHE_RPC=...

# ── Aggregators ────────────────────────────────────────────────────────
# EVM swaps route through 0x. Free key: https://dashboard.0x.org
ZEROX_API_KEY=
# Solana swaps route through Jupiter (free lite-api by default).
JUPITER_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=
# Optional: explorer key to scan your wallet's real token holdings (/scan, /wallet).
# Free from https://etherscan.io/apis — ONE Etherscan key covers BSC via the
# unified V2 API (the old per-chain bscscan.com API is deprecated).
BSCSCAN_API_KEY=

# ── Execution ──────────────────────────────────────────────────────────
DRY_RUN=true                            # true = never actually swaps
AUTO_TRADE=false                        # true = buy the instant a call passes
                                        # false = DM you a Buy/Skip button
BUY_AMOUNT_USD=2                        # USD spent per buy, on ANY chain
SLIPPAGE_BPS=300                        # 3% entries
SELL_SLIPPAGE_BPS=1500                  # 15% exits — get out fast
SELL_GAS_MULT=1.3                       # bump gas 1.3x on sells so exits land fast

# four.meme launchpad (BSC) — trade bonding-curve tokens 0x can't reach yet
FOURMEME_ENABLED=true
FOURMEME_SLIPPAGE_BPS=1500               # 15% — bonding curves move fast

# ── Gas guard (skip buys where fees eat the position) ──────────────────
MAX_GAS_PCT=25                          # skip buy if gas > 25% of BUY_AMOUNT_USD
MAX_GAS_USD=0                           # optional hard cap in USD (0 = off)
SWAP_GAS_UNITS=250000                   # assumed gas units per swap (estimate)

# ── Take-profit: "sell 50% at 2x / 100% ROI" ───────────────────────────
TAKE_PROFIT_ENABLED=true                # false = never auto-sell; you exit with
                                        # /sell (no take-profit, no stop-loss)
TAKE_PROFIT_MULT=2.0                    # 2.0 = 2x = +100% ROI
TAKE_PROFIT_SELL_PCT=50                 # % of the position to sell at that mult
POLL_INTERVAL_SEC=30                    # how often to re-price open positions

# Rug / stop-loss auto-sell: if a position falls this % below entry, sell 100%.
# 0 = off. (Polling can't beat an instant liquidity pull — catches bleeds.)
STOP_LOSS_PCT=70

# ── Safety gate (multichain: DexScreener + GoPlus) ─────────────────────
MIN_LIQUIDITY_USD=5000                  # skip illiquid pools you can't exit
MIN_PAIR_AGE_MIN=0                      # e.g. 5 to avoid 0-second snipes
MAX_BUY_TAX_PCT=10                      # reject high buy-tax tokens
MAX_SELL_TAX_PCT=10                     # reject high sell-tax tokens
REQUIRE_MINT_AUTHORITY_REVOKED=true     # reject if supply can still be minted
STRICT_SAFETY=false                     # true = reject when security data is
                                        # missing (safer, skips very fresh calls)

# Sellability / anti-honeypot (the biggest protection against rugs)
HONEYPOT_CHECK=true                     # simulate a real buy+sell before buying
MAX_HONEYPOT_TAX_PCT=15                 # reject tokens with sell tax above this
MIN_HOLDERS=0                           # optional minimum holder count (0 = off)
